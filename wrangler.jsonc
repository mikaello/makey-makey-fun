{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "makey-makey-fun",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-06",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
